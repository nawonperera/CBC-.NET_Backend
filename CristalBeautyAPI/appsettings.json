{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDb": {
    "ConnectionString": "YOUR_MONGODB_CONNECTION_STRING",
    "DatabaseName": "YOUR_DATABASE_NAME"
  },
  "Jwt": {
    "Key": "YOUR_JWT_SECRET_KEY"
  },
  "Email": {
    "SenderEmail": "YOUR_EMAIL_ADDRESS",
    "AppPassword": "YOUR_EMAIL_APP_PASSWORD"
  }
}